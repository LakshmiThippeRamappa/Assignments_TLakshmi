package com.classroom.model;

import jakarta.persistence.*;
import java.time.LocalDateTime;

@Entity
@Table(name = "classrooms")
public class Classroom {
    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    private Long courseId;     // ID from Course service
    private Long teacherId;    // ID from User service

    private LocalDateTime startTime;
    private LocalDateTime endTime;

    // Simple attendee storage: comma-separated userIds (avoid mapping annotations)
    private String attendeeIdsCsv;

    private boolean active; // whether session is currently active

    // Getters and Setters
}
